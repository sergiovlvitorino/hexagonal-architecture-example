type Query {
    findAll(pageNumber: Int!, pageSize: Int!, orderBy: String!, asc: Boolean!, userName: String): UserPage!
    findById(id: ID!): User
}

type Mutation {
    updateUser(id: ID!, name: String!): User!
    deleteUser(id: ID!): Boolean!
}

type UserPage {
    content: [User!]!
    totalElements: Int!
    totalPages: Int!
    number: Int!
    size: Int!
}

type User {
    id: ID!
    name: String!
}
